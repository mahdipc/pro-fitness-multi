{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UserFitnessProfile.schema.json",
  "title": "UserFitnessProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "age": { "type": ["integer", "null"], "minimum": 10, "maximum": 100 },
    "sex": { "type": ["string", "null"], "enum": ["male", "female", "other", "unknown", null] },
    "heightCm": { "type": ["number", "null"], "minimum": 50, "maximum": 250 },
    "weightKg": { "type": ["number", "null"], "minimum": 20, "maximum": 300 },
    "goal": { "type": ["string", "null"] },
    "goalTimeline": { "type": ["string", "null"] },
    "trainingLevel": { "type": ["string", "null"], "enum": ["beginner", "intermediate", "advanced", "unknown", null] },
    "availableDaysPerWeek": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
    "sessionMinutes": { "type": ["integer", "null"], "minimum": 10, "maximum": 240 },
    "equipment": { "type": "array", "items": { "type": "string" } },
    "injuries": { "type": "array", "items": { "type": "string" } },
    "medicalConditions": { "type": "array", "items": { "type": "string" } },
    "medications": { "type": "array", "items": { "type": "string" } },
    "sleepQuality": { "type": ["string", "null"], "enum": ["good", "average", "poor", "unknown", null] },
    "stressLevel": { "type": ["string", "null"], "enum": ["low", "medium", "high", "unknown", null] },
    "activityLevel": { "type": ["string", "null"], "enum": ["sedentary", "light", "moderate", "high", "unknown", null] },
    "preferences": { "type": "array", "items": { "type": "string" } },
    "sourceFacts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "age",
    "sex",
    "heightCm",
    "weightKg",
    "goal",
    "trainingLevel",
    "availableDaysPerWeek",
    "sessionMinutes",
    "equipment",
    "injuries",
    "medicalConditions",
    "medications",
    "sleepQuality",
    "stressLevel",
    "activityLevel",
    "preferences",
    "sourceFacts",
    "assumptions"
  ]
}
