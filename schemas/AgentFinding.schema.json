{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentFinding.schema.json",
  "title": "AgentFinding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim": { "type": "string" },
    "basis": {
      "type": "string",
      "enum": ["user_input", "rule_engine", "exercise_library", "calculation", "assumption", "agent_inference"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": ["string", "null"] }
  },
  "required": ["claim", "basis", "confidence"]
}
